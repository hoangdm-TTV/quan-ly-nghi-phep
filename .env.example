# Database Connection (PostgreSQL)
# Lưu ý: Không chia sẻ tệp .env.local chứa mật khẩu thật
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/quan_ly_nghi_phep

# Session Secret (Chuỗi ngẫu nhiên dài dùng để ký/bảo mật session)
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars
